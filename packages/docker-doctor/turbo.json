{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      // The tests run dist/cli.mjs and import dist/index.mjs, so they need
      // this package's own build on top of the root's "^build".
      "dependsOn": ["$TURBO_EXTENDS$", "build"]
    }
  }
}
