{
  "name": "@docker-doctor/cli",
  "version": "0.4.3",
  "description": "Static analysis for Dockerfile and Docker Compose files",
  "keywords": [
    "best-practices",
    "diagnostics",
    "docker",
    "docker-compose",
    "dockerfile",
    "linter",
    "performance",
    "security"
  ],
  "homepage": "https://docker-doctor.vercel.app",
  "bugs": {
    "url": "https://github.com/PunGrumpy/docker-doctor/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Noppakorn Kaewsalabnil",
    "url": "https://www.pungrumpy.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PunGrumpy/docker-doctor.git",
    "directory": "packages/docker-doctor"
  },
  "bin": {
    "docker-doctor": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "skill",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=4096' tsdown",
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' tsdown --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "git clean -xdf .turbo node_modules dist skill"
  },
  "dependencies": {
    "agent-install": "0.0.8",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@docker-doctor/core": "workspace:*",
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
