{
  "name": "docker-doctor-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "kits/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "test": "turbo run test",
    "test:scripts": "bun test ./scripts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "clean": "turbo run clean && git clean -xdf node_modules",
    "changeset": "changeset",
    "changeset:version": "changeset version && bun run kit:sync && bun install",
    "changeset:publish": "turbo run build --filter @docker-doctor/cli && changeset publish",
    "kit:sync": "bun scripts/sync-kit-spec.ts",
    "doctor": "react-doctor",
    "docs:rules": "bun scripts/generate-rules-doc.ts",
    "check:rule-count": "bun scripts/check-rule-count.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@gdp-ts/core": "^0.1.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "husky": "^9.1.7",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-plugin-react-doctor": "^0.9.16",
    "oxlint-tsgolint": "^7.0.2004",
    "react-doctor": "^0.9.18",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2",
    "ultracite": "8.0.1"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.3.14"
}
