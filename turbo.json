{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  // apps/web renders packages/docker-doctor/CHANGELOG.md at build time, but
  // that file sits outside web's package dir and outside its dependency
  // graph, so nothing else would invalidate the cached build for it.
  "globalDependencies": ["packages/docker-doctor/CHANGELOG.md"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"],
      "env": ["SKIP_ENV_VALIDATION"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false,
      "persistent": true
    }
  }
}
