{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  // apps/web renders packages/docker-doctor/CHANGELOG.md at build time, but
  // that file sits outside web's package dir and outside its dependency
  // graph, so nothing else would invalidate the cached build for it.
  "globalDependencies": ["packages/docker-doctor/CHANGELOG.md"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        "skill/**"
      ],
      "env": ["SKIP_ENV_VALIDATION"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    // Tests build the packages they depend on, not their own package: most
    // packages have no test script, and a package that needs its own build
    // says so in its turbo.json (see packages/docker-doctor/turbo.json).
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false,
      "persistent": true
    }
  }
}
